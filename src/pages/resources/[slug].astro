---
import { getCollection, render } from 'astro:content';
import TeacherResourceLayout from '../../layouts/TeacherResourceLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('teacher-resources', ({ data }) =>
    data.status === 'published' && data.visibility === 'public'
  );
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---
<TeacherResourceLayout
  title={article.data.seoTitle || `${article.data.title} | CSM Teacher Blog`}
  description={article.data.seoDescription || article.data.description}
  canonicalPath={article.data.canonicalPath || `/resources/${article.id}/`}
  visibility={article.data.visibility}
  noindex={article.data.noindex}
>
  <div class="container-sm blog-article">
    <a class="back-link" href="/resources/">All teaching articles</a>
    <h1>{article.data.title}</h1>
    {article.data.publishDate && <p class="article-date"><time datetime={article.data.publishDate.toISOString()}>{article.data.publishDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time></p>}
    <div class="article-body"><Content /></div>
  </div>
</TeacherResourceLayout>
<style>
  .blog-article{padding-top:3.5rem;padding-bottom:4.5rem}
  .back-link{display:inline-block;margin-bottom:1.5rem;text-decoration:underline}
  h1{margin-bottom:1rem}
  .article-date{color:var(--mid);font-size:.9rem;margin-bottom:2rem}
  .article-body :global(h2){margin:2.5rem 0 1rem;font-size:1.6rem}
  .article-body :global(p){margin-bottom:1.2rem}
  .article-body :global(a){text-decoration:underline}
</style>
